# ─────────────────────────────────────────────────────
# Random-Walk OTP System — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────

# Server storage master key (Fernet key — 32 bytes base64url encoded).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALK_OTP_MASTER_KEY=REPLACE_ME_WITH_FERNET_KEY

# Client passphrase (optional — if unset, CLI will prompt interactively).
# Only use this in development / CI environments, NOT in production.
# WALK_OTP_CLIENT_PASS=dev_passphrase_here
