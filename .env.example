# SMTP configuration
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_16_character_google_app_password
# EMAIL_FROM=your_email@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# This MUST be a URL that the user's browser can open from the email.
# Example:
# APP_BASE_URL=https://your-public-streamlit-url.example.com
APP_BASE_URL=

